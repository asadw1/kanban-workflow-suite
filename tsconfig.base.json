{
  // Shared compiler baseline for every workspace. Packages extend this file and add only
  // what is specific to them (paths, lib, jsx, output). Keep this strict: loosening a flag
  // here loosens it for the whole monorepo.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Forces `import type` for type-only imports, matching the ESLint consistent-type-imports rule.
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // CLAUDE.md: strict mode is mandatory. The extra flags below catch real bugs in
    // index-based access (e.g. Lexorank neighbour lookups) and accidental method overrides.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  }
}
