datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CustomFieldType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  CHECKBOX
  USER
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String
  avatarUrl     String?
  // Argon2/scrypt hash in the self-describing format written by the API's PasswordHasher.
  // Nullable so seeded users and any future external-identity users (TAD open question 2)
  // exist without a password; login must reject accounts where this is null.
  passwordHash  String?
  refreshTokens RefreshToken[]
  memberships   WorkspaceMember[]
  assignedCards Card[]            @relation("AssignedUser")
  comments      Comment[]
  createdCards  Card[]            @relation("CreatedUser")
  attachments   Attachment[]
  activityLogs  ActivityLog[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// One row per issued refresh token. Only the SHA-256 of the token is stored, so a database
// leak does not yield usable sessions. Tokens rotate on every use; `familyId` groups a login
// session's chain so reuse of an already-rotated token revokes the whole chain.
model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  familyId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  // Set only when the token was rotated (not logged out); a replay shortly after is a benign
  // duplicate refresh, not theft. See AuthService.refresh.
  rotatedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  // Supports the periodic purge of expired rows.
  @@index([expiresAt])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  members     WorkspaceMember[]
  boards      Board[]
  automations AutomationRule[]
  customFields CustomField[]
  tags        Tag[]
  logs        ActivityLog[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  role        Role      @default(MEMBER)
  userId      String
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  // The unique index above leads with userId, so member lists by workspace need their own index.
  @@index([workspaceId])
}

model Board {
  id          String    @id @default(cuid())
  title       String
  position    String    // Lexorank
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     Column[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, position])
}

model Column {
  id        String   @id @default(cuid())
  title     String
  position  String   // Lexorank
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, position])
}

model Card {
  id            String            @id @default(cuid())
  title         String
  description   String?
  position      String            // Lexorank
  priority      Priority          @default(MEDIUM)
  dueDate       DateTime?
  columnId      String
  column        Column            @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assigneeId    String?
  assignee      User?             @relation("AssignedUser", fields: [assigneeId], references: [id])
  creatorId     String
  creator       User              @relation("CreatedUser", fields: [creatorId], references: [id])
  comments      Comment[]
  fieldValues   CustomFieldValue[]
  checklists    Checklist[]
  attachments   Attachment[]
  tags          TagOnCard[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Hottest read path: rendering a column's cards in display order.
  @@index([columnId, position])
}

model CustomField {
  id          String             @id @default(cuid())
  name        String
  fieldType   CustomFieldType
  options     String[]           // For SELECT / MULTI_SELECT types
  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values      CustomFieldValue[]
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  value         Json        // Shape depends on fieldType (e.g., string[] for MULTI_SELECT)
  cardId        String
  card          Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([cardId, customFieldId])
}

model AutomationRule {
  id          String    @id @default(cuid())
  name        String
  triggerType String    // e.g., CARD_MOVED, CARD_CREATED, DUE_DATE_APPROACHING
  triggerConfig Json
  actionType  String    // e.g., REASSIGN, SEND_WEBHOOK, CHANGE_PRIORITY
  actionConfig  Json
  isActive    Boolean   @default(true)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Checklist {
  id        String          @id @default(cuid())
  title     String
  cardId    String
  card      Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  items     ChecklistItem[]
}

model ChecklistItem {
  id          String    @id @default(cuid())
  content     String
  isCompleted Boolean   @default(false)
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Attachment {
  id         String   @id @default(cuid())
  fileName   String
  fileUrl    String
  mimeType   String
  sizeBytes  Int
  cardId     String
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Tag {
  id          String      @id @default(cuid())
  name        String
  color       String
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards       TagOnCard[]

  @@unique([workspaceId, name])
}

model TagOnCard {
  cardId String
  tagId  String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
}

model ActivityLog {
  id          String    @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  details     Json?
  actorId     String?   // Null when the user is deleted or the action is system-generated
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}
